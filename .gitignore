# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/

# BenchCam local config (e.g. saved OBS WebSocket password): never commit
.benchcam/
.env

# BenchCam local data: never commit sessions or media
sessions/
*.mp4
*.mkv
*.mov
*.avi
*.flv
*.wav
*.mp3
*.m4a
*.png
*.jpg
*.jpeg
_trash/
*.bak-*

# KiCad: editor/tool state and backups, never design source. The design files,
# gerbers and mill gcode under control-board/ ARE tracked (see the README) -
# this board was milled from those exact files and cannot be re-ordered from a
# fab, so they are the reproduction record.
#
# KiCad Local History and restore snapshots each contain their own nested .git,
# which git would otherwise try to record as a broken gitlink.
.history/
_restore_backup_*/
*-backups/
fp-info-cache
# Per-user window/UI state (NOT project settings - .kicad_pro is tracked).
*.kicad_prl
*.kicad_*-bak
_autosave-*
*.lck
~*.lck

# ...but board photos under control-board/ ARE tracked. The media ignores above
# exist to keep session captures out of git; a milled board is documented by
# pictures as much as by files, and this repo is the build log for it. Negations
# must follow the *.png/*.jpg rules they override.
!control-board/**/*.png
!control-board/**/*.jpg
!control-board/**/*.jpeg
